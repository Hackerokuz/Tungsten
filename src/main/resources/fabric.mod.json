{
  "schemaVersion": 1,
  "id": "tungsten",
  "version": "${version}",
  "name": "Tungsten",
  "description": "Pathfinder!",
  "authors": [
    "Hackerokuz"
  ],
  "contact": {
    "homepage": "https://github.com/Hackerokuz/Tungsten",
